#!/usr/bin/env bash
set -euo pipefail

state_dir="$HOME/.local/share/termux-ai"
version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'
safe_text_pattern='^[A-Za-z0-9 ._()/+:-]{1,60}$'

show_help() {
    printf '%s\n' \
        'Uso: ia [copilot|claude|codex|antigravity|agy|opencode|embeddinggemma|terminal] [argumentos]' \
        '     ia versoes' \
        '     ia atualizar [--yes] [agente...]' \
        '     ia diagnostico' \
        '     ia web [start|stop|status] [terminal|embedding]' \
        '     ia embeddinggemma install' \
        'Sem argumentos, abre o menu em uma sessao interativa.' \
        'versoes: compara as versoes instaladas com as mais recentes.' \
        'atualizar: mostra o plano e atualiza os agentes apos confirmacao.' \
        'diagnostico: verifica Linux, agentes, logins e protecoes.' \
        'web: abre o terminal Linux com menu e o EmbeddingGemma 2 no navegador, so em 127.0.0.1.' \
        'Codex: sem sandbox no Android/PRoot; abre no modo Pedir aprovacao.' \
        '       Para escolher outro modo, informe -s/--sandbox ou -a/--ask-for-approval.' \
        'Antigravity CLI: comandos antigravity ou agy.' \
        'OpenCode: integracao experimental, sem validacao em Android/PRoot.' \
        'EmbeddingGemma 2: embeddings locais e opcionais via embeddinggemma ou embedding.'
}

display_name() {
    case "$1" in
        copilot) printf '%s' 'GitHub Copilot' ;;
        claude) printf '%s' 'Claude Code' ;;
        codex) printf '%s' 'Codex' ;;
        agy) printf '%s' 'Antigravity CLI' ;;
        opencode) printf '%s' 'OpenCode' ;;
        embeddinggemma|embedding) printf '%s' 'EmbeddingGemma 2' ;;
    esac
}

require_proot_distro() {
    if ! command -v proot-distro >/dev/null 2>&1; then
        printf '%s\n' 'PRoot-Distro nao encontrado. Execute bash install.sh pelo Termux.' >&2
        exit 1
    fi
}

# linux.conf e lido como dados, nunca executado.
load_linux_config() {
    local config_key config_value
    linux_name=termux-ai
    linux_user=node
    if [[ -f "$state_dir/linux.conf" ]]; then
        while IFS='=' read -r config_key config_value || [[ -n $config_key ]]; do
            case "$config_key" in
                name) linux_name="$config_value" ;;
                user) linux_user="$config_value" ;;
            esac
        done < "$state_dir/linux.conf"
    fi
    if [[ ! $linux_name =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ || ! $linux_user =~ ^[a-z_][a-z0-9_-]*$ ]]; then
        printf 'Configuracao invalida em %s/linux.conf.\n' "$state_dir" >&2
        exit 1
    fi
    login_args=(login "$linux_name")
    if [[ $linux_user != root ]]; then
        login_args+=(--user "$linux_user")
    fi
}

prepare_maintenance() {
    if [[ ${TERMUX_AI_GUEST:-} == 1 ]]; then
        printf '%s\n' 'Use ia versoes, ia atualizar e ia diagnostico no Termux, fora do Linux.' >&2
        exit 1
    fi
    require_proot_distro
    load_linux_config
}

run_linux_stage() {
    if [[ ! -f "$state_dir/setup-linux.sh" ]]; then
        printf '%s\n' 'Componentes de atualizacao ausentes. Execute novamente bash install.sh pelo Termux.' >&2
        return 1
    fi
    PROOT_VERBOSE=-1 proot-distro "${login_args[@]}" -- /bin/bash -se -- "$@" < "$state_dir/setup-linux.sh"
}

install_embeddinggemma() {
    if (( $# > 0 )); then
        printf '%s\n' 'Uso: ia embeddinggemma install' >&2
        return 2
    fi
    prepare_maintenance
    if [[ ! -f "$state_dir/setup-linux.sh" ]]; then
        printf '%s\n' 'Componentes de instalacao ausentes. Execute novamente bash install.sh pelo Termux.' >&2
        return 1
    fi
    printf '%s\n' 'Instalando Python e as dependencias opcionais do EmbeddingGemma no Linux.'
    PROOT_VERBOSE=-1 proot-distro login "$linux_name" -- /bin/bash -se -- embeddinggemma-system < "$state_dir/setup-linux.sh" \
        || return
    run_linux_stage embeddinggemma-install
}

read_versions() {
    local output marker tool installed latest status
    version_rows=()
    printf 'Consultando as versoes no Linux %s...\n' "$linux_name"
    if ! output="$(run_linux_stage versions)"; then
        printf '%s\n' 'Nao foi possivel consultar as versoes no Linux.' >&2
        return 1
    fi
    while IFS=$'\t' read -r marker tool installed latest status; do
        [[ $marker == @version ]] || continue
        case "$tool" in
            copilot|claude|codex|agy|opencode) ;;
            *) continue ;;
        esac
        [[ $installed == - || $installed =~ $version_pattern ]] || continue
        [[ $latest == - || $latest =~ $version_pattern ]] || continue
        case "$status" in
            current|outdated|missing|unknown) version_rows+=("$tool $installed $latest $status") ;;
        esac
    done <<< "$output"
    if (( ${#version_rows[@]} == 0 )); then
        printf '%s\n' 'Nao foi possivel consultar as versoes no Linux.' >&2
        return 1
    fi
}

status_label() {
    case "$1" in
        current) printf '%s' 'atualizado' ;;
        outdated) printf '%s' 'atualizacao disponivel' ;;
        missing) printf '%s' 'nao instalado' ;;
        unknown) printf '%s' 'sem consulta' ;;
    esac
}

print_version_table() {
    local row tool installed latest status
    printf '\n%-16s %-12s %-12s %s\n' 'Agente' 'Instalada' 'Disponivel' 'Situacao'
    for row in "${version_rows[@]}"; do
        read -r tool installed latest status <<< "$row"
        printf '%-16s %-12s %-12s %s\n' "$(display_name "$tool")" "$installed" "$latest" "$(status_label "$status")"
    done
}

can_update() {
    [[ $3 != - && ( $4 == outdated || $4 == missing ) ]]
}

show_versions() {
    local row tool installed latest status
    if (( $# > 0 )); then
        show_help >&2
        return 2
    fi
    read_versions || return 1
    print_version_table
    for row in "${version_rows[@]}"; do
        read -r tool installed latest status <<< "$row"
        if can_update "$tool" "$installed" "$latest" "$status"; then
            printf '\n%s\n' 'Para atualizar: ia atualizar'
            break
        fi
    done
}

update_agents() {
    local assume_yes=0 argument row tool installed latest status answer failed_list=''
    local -a selected=() plan=()
    for argument in "$@"; do
        case "$argument" in
            --yes|-y) assume_yes=1 ;;
            copilot|claude|codex|opencode) selected+=("$argument") ;;
            antigravity|agy) selected+=(agy) ;;
            *)
                printf 'Agente desconhecido: %s\n' "$argument" >&2
                show_help >&2
                return 2
                ;;
        esac
    done
    read_versions || return 1
    print_version_table
    for row in "${version_rows[@]}"; do
        read -r tool installed latest status <<< "$row"
        if (( ${#selected[@]} > 0 )) && [[ " ${selected[*]} " != *" $tool "* ]]; then
            continue
        fi
        if can_update "$tool" "$installed" "$latest" "$status"; then
            plan+=("$row")
        fi
    done
    if (( ${#plan[@]} == 0 )); then
        printf '\n%s\n' 'Nenhuma atualizacao disponivel para os agentes selecionados.'
        return 0
    fi
    printf '\n%s\n' 'Atualizacoes planejadas:'
    for row in "${plan[@]}"; do
        read -r tool installed latest status <<< "$row"
        printf '  %-16s %s -> %s\n' "$(display_name "$tool")" "$installed" "$latest"
    done
    printf '%s\n' 'Feche os agentes abertos antes de continuar.'
    if (( ! assume_yes )); then
        if [[ ! -t 0 ]]; then
            printf '%s\n' 'Sem entrada interativa. Revise o plano e use ia atualizar --yes para confirmar.' >&2
            return 1
        fi
        read -r -p 'Atualizar agora? [s/N] ' answer || answer=''
        case "$answer" in
            s|S|sim|SIM|y|Y|yes) ;;
            *) printf '%s\n' 'Atualizacao cancelada.'; return 0 ;;
        esac
    fi
    for row in "${plan[@]}"; do
        read -r tool installed latest status <<< "$row"
        printf '\n== %s %s ==\n' "$(display_name "$tool")" "$latest"
        if ! run_linux_stage update "$tool" "$latest"; then
            failed_list+="${failed_list:+, }$(display_name "$tool")"
        fi
    done
    if [[ -n $failed_list ]]; then
        printf '\nFalha ao atualizar: %s. Revise as mensagens acima e tente novamente.\n' "$failed_list" >&2
        return 1
    fi
    printf '\n%s\n' 'Atualizacao concluida.'
}

# Aceita somente linhas conhecidas; qualquer outra saida do Linux e ignorada.
valid_diag_line() {
    local kind="$1" name="$2" status="$3" detail="$4"
    case "$kind" in
        check)
            case "$name:$status" in
                distro:ok) [[ $detail == - || $detail =~ $safe_text_pattern ]] ;;
                node:ok|node:old|git:ok) [[ $detail =~ $version_pattern ]] ;;
                node:missing|git:missing|network:ok|network:fail|workdir:ok|workdir:fail|workdir:skip) [[ $detail == - ]] ;;
                *) return 1 ;;
            esac
            ;;
        agent)
            case "$name" in
                copilot|claude|codex|agy|opencode) ;;
                *) return 1 ;;
            esac
            case "$status" in
                yes|no|unknown) [[ $detail =~ $version_pattern ]] ;;
                missing|broken) [[ $detail == - ]] ;;
                *) return 1 ;;
            esac
            ;;
        isolation)
            [[ $name == codex ]] || return 1
            case "$status" in
                unavailable|ineffective|active|missing) [[ $detail == - ]] ;;
                *) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

agent_state_label() {
    case "$1" in
        yes) printf '%s' 'login ok' ;;
        no) printf '%s' 'sem login' ;;
        unknown) printf '%s' 'login nao verificado' ;;
        missing) printf '%s' 'nao instalado' ;;
        broken) printf '%s' 'nao inicia' ;;
        *) printf '%s' 'nao verificado' ;;
    esac
}

login_hint() {
    case "$1" in
        copilot) printf '%s' 'GitHub Copilot: entre com ia copilot login.' ;;
        claude) printf '%s' 'Claude Code: entre com ia claude auth login.' ;;
        codex) printf '%s' 'Codex: entre com ia codex login.' ;;
        agy) printf '%s' 'Antigravity CLI: abra ia agy e conclua o login.' ;;
        opencode) printf '%s' 'OpenCode: entre com ia opencode auth login; sem chave de API, use GitHub Copilot ou ChatGPT Plus/Pro.' ;;
    esac
}

show_diagnostics() {
    local output marker kind name status detail tool label release machine termux_version proot_version available_kib
    local system_hint=0
    local -A diag_status=() diag_detail=()
    local -a next_steps=()
    if (( $# > 0 )); then
        show_help >&2
        return 2
    fi
    release="$(getprop ro.build.version.release 2> /dev/null)" || release=''
    [[ $release =~ ^[0-9A-Za-z._-]{1,20}$ ]] || release='?'
    machine="$(uname -m 2> /dev/null)" || machine=''
    [[ $machine =~ ^[0-9A-Za-z_]{1,20}$ ]] || machine='?'
    termux_version="${TERMUX_VERSION:-}"
    [[ $termux_version =~ ^[0-9A-Za-z._+-]{1,40}$ ]] || termux_version='?'
    # shellcheck disable=SC2016
    proot_version="$(dpkg-query -W -f='${Version}' proot-distro 2> /dev/null)" || proot_version=''
    [[ $proot_version =~ ^[0-9A-Za-z.+~:-]{1,40}$ ]] || proot_version='?'
    available_kib="$(df -Pk "$HOME" 2> /dev/null | awk 'NR == 2 { print $4 }')" || available_kib=''
    printf '\n%s\n\n%s\n' 'Diagnostico do Termux AI' 'Termux'
    printf '  %-15s %s (%s)\n' Android "$release" "$machine"
    printf '  %-15s %s\n' Termux "$termux_version"
    printf '  %-15s %s\n' PRoot-Distro "$proot_version"
    if [[ $available_kib =~ ^[0-9]{1,15}$ ]]; then
        available_kib=$((10#$available_kib))
        printf '  %-15s %d.%d GiB\n' 'Espaco livre' $((available_kib / 1048576)) $((available_kib % 1048576 * 10 / 1048576))
        if (( available_kib < 2 * 1048576 )); then
            next_steps+=('Pouco espaco livre: mantenha pelo menos 2 GiB para atualizar os agentes.')
        fi
    else
        printf '  %-15s %s\n' 'Espaco livre' '?'
    fi
    printf '  %-15s %s, usuario %s\n' Linux "$linux_name" "$linux_user"
    printf '\nConsultando o Linux %s...\n' "$linux_name"
    output="$(run_linux_stage diagnose "$PWD")" || true
    while IFS=$'\t' read -r marker kind name status detail; do
        [[ $marker == @diag ]] || continue
        valid_diag_line "$kind" "$name" "$status" "$detail" || continue
        diag_status["$kind:$name"]="$status"
        diag_detail["$kind:$name"]="$detail"
    done <<< "$output"
    if (( ${#diag_status[@]} == 0 )); then
        printf '%s\n' 'Nao foi possivel consultar o Linux. Execute novamente bash install.sh no Termux.' >&2
        return 1
    fi

    printf '\n%s\n' Linux
    label="${diag_detail[check:distro]:--}"
    [[ $label != - ]] || label='?'
    printf '  %-15s %s\n' Sistema "$label"
    case "${diag_status[check:node]:-}" in
        ok) label="${diag_detail[check:node]}" ;;
        old) label="${diag_detail[check:node]} (requer 22 ou superior)"; system_hint=1 ;;
        missing) label='nao encontrado'; system_hint=1 ;;
        *) label='nao verificado' ;;
    esac
    printf '  %-15s %s\n' Node.js "$label"
    case "${diag_status[check:git]:-}" in
        ok) label="${diag_detail[check:git]}" ;;
        missing) label='nao encontrado'; system_hint=1 ;;
        *) label='nao verificado' ;;
    esac
    printf '  %-15s %s\n' Git "$label"
    if (( system_hint )); then
        next_steps+=('Node.js 22+ e Git sao necessarios no Linux: execute novamente bash install.sh no Termux.')
    fi
    case "${diag_status[check:network]:-}" in
        ok) label='ok' ;;
        fail)
            label='sem acesso'
            next_steps+=('Sem internet no Linux: confira a conexao; os agentes dependem dela.')
            ;;
        *) label='nao verificada' ;;
    esac
    printf '  %-15s %s\n' Internet "$label"
    case "${diag_status[check:workdir]:-}" in
        ok) label='aceita gravacao' ;;
        fail)
            label='sem gravacao'
            next_steps+=('A pasta atual nao aceita gravacao no Linux: abra os agentes em uma pasta da home do Termux.')
            ;;
        *) label='nao verificada' ;;
    esac
    printf '  %-15s %s\n' 'Pasta atual' "$label"

    printf '\n%s\n  %-16s %-12s %s\n' Agentes Agente Versao Situacao
    for tool in copilot claude codex agy opencode; do
        status="${diag_status[agent:$tool]:-}"
        printf '  %-16s %-12s %s\n' "$(display_name "$tool")" "${diag_detail[agent:$tool]:--}" "$(agent_state_label "$status")"
        case "$status" in
            no) next_steps+=("$(login_hint "$tool")") ;;
            missing) next_steps+=("$(display_name "$tool"): instale com ia atualizar $tool.") ;;
            broken) next_steps+=("$(display_name "$tool"): reinstale com ia atualizar $tool.") ;;
        esac
    done

    printf '\n%s\n  %s\n' Protecao 'PRoot nao isola os agentes: eles acessam os mesmos arquivos que o Termux.'
    case "${diag_status[agent:codex]:-}" in
        missing|broken) ;;
        *)
            case "${diag_status[isolation:codex]:-}" in
                unavailable) printf '  %s\n' 'Codex: o sandbox nao funciona aqui; ia codex abre no modo Pedir aprovacao.' ;;
                ineffective)
                    printf '  %s\n' 'Codex: o sandbox iniciou, mas nao bloqueou uma gravacao de teste.'
                    next_steps+=('Codex: nao confie no sandbox, pois comandos podem rodar sem aprovacao; use pastas com backup ou Git.')
                    ;;
                active) printf '  %s\n' 'Codex: o sandbox bloqueou uma gravacao de teste.' ;;
                *) printf '  %s\n' 'Codex: sandbox nao verificado.' ;;
            esac
            ;;
    esac
    printf '  %s\n' 'Demais agentes: valem as confirmacoes de cada agente.'

    printf '\n%s\n' 'Proximos passos'
    if (( ${#next_steps[@]} == 0 )); then
        printf '  %s\n' 'Nenhuma acao necessaria.'
    else
        printf '  - %s\n' "${next_steps[@]}"
    fi
}

# Sem sandbox no Android/PRoot, o Codex so pede aprovacao no modo on-request.
# Flags proprias de permissao, perfil ou ajuda mantem a escolha do usuario.
classify_codex_args() {
    local -a arguments=("$@")
    local index argument config_key skip_value=0 command_index=-1
    codex_mode=ask
    codex_insert_index=0
    for (( index = 0; index < ${#arguments[@]}; index++ )); do
        argument="${arguments[index]}"
        if (( skip_value )); then
            skip_value=0
            continue
        fi
        config_key=''
        case "$argument" in
            --) break ;;
            -h|--help|-V|--version)
                codex_mode=none
                return 0
                ;;
            -s|-s?*|--sandbox|--sandbox=*|-a|-a?*|--ask-for-approval|--ask-for-approval=*|-p|-p?*|--profile|--profile=*|--approve-for-me|--dangerously-bypass-approvals-and-sandbox|--full-auto|--yolo)
                codex_mode=own
                return 0
                ;;
            -c|--config)
                config_key="${arguments[index + 1]:-}"
                skip_value=1
                ;;
            -c?*) config_key="${argument#-c}" ;;
            --config=*) config_key="${argument#--config=}" ;;
            -m|--model|-i|--image|-C|--cd|--add-dir|--enable|--disable|--remote|--remote-auth-token-env|--local-provider) skip_value=1 ;;
            -*) ;;
            *) (( command_index >= 0 )) || command_index=$index ;;
        esac
        config_key="${config_key%%=*}"
        case "${config_key//[[:space:]]/}" in
            sandbox_mode|approval_policy|approval_policy.*|default_permissions|permissions|permissions.*|profile)
                codex_mode=own
                return 0
                ;;
        esac
    done
    (( command_index >= 0 )) || return 0
    case "${arguments[command_index]}" in
        resume|fork) codex_insert_index=$((command_index + 1)) ;;
        exec|e|review) codex_mode=warn ;;
        agents|login|logout|mcp|mcp-server|plugin|app-server|remote-control|completion|update|doctor|sandbox|debug|apply|a|queue|archive|delete|migrate-rollouts|unarchive|cloud|exec-server|features|help) codex_mode=none ;;
    esac
}

run_maintenance() {
    local status=0
    prepare_maintenance
    "$@" || status=$?
    return "$status"
}

run_web_stage() {
    if [[ ${TERMUX_AI_GUEST:-} == 1 ]]; then
        printf '%s\n' 'Use ia web no Termux, fora do Linux.' >&2
        return 1
    fi
    require_proot_distro
    load_linux_config
    if [[ ! -f "$state_dir/webui.sh" || ! -f "$state_dir/web/menu.sh" || ! -f "$state_dir/tools/embeddinggemma_web.py" ]]; then
        printf '%s\n' 'Arquivos da WebUI ausentes. Atualize o repositorio e execute bash install.sh no Termux.' >&2
        return 1
    fi
    local action="$1" target="$2"
    PROOT_VERBOSE=-1 proot-distro "${login_args[@]}" --work-dir "$PWD" --no-kill-on-exit -- \
        /bin/bash -se -- "$action" "$target" < "$state_dir/webui.sh"
}

manage_web() {
    local action="${1:-start}" target="${2:-both}"
    if (( $# > 2 )); then
        printf '%s\n' 'Uso: ia web [start|stop|status] [terminal|embedding]' >&2
        return 2
    fi
    case "$action:$target" in
        start:both|start:terminal|start:embedding|stop:both|stop:terminal|stop:embedding|status:both|status:terminal|status:embedding) ;;
        *)
            printf '%s\n' 'Uso: ia web [start|stop|status] [terminal|embedding]' >&2
            return 2
            ;;
    esac
    run_web_stage "$action" "$target" || return
    if [[ $action == start ]]; then
        [[ $target == embedding ]] || printf '%s\n' 'Terminal: http://127.0.0.1:7680'
        [[ $target == terminal ]] || printf '%s\n' 'EmbeddingGemma: http://127.0.0.1:8085'
        printf '%s\n' 'Acesso restrito a este aparelho (127.0.0.1). Para encerrar: ia web stop'
    fi
}

launcher_name="${0##*/}"
if [[ "$launcher_name" == ia ]]; then
    if [[ $# -eq 0 ]]; then
        if [[ ! -t 0 || ! -t 1 ]]; then
            show_help
            exit 0
        fi
        while true; do
            printf '\nTermux AI\n\n1. GitHub Copilot\n2. Claude Code\n3. Codex (experimental)\n4. Terminal Linux\n5. Google Antigravity CLI\n6. OpenCode (experimental)\n7. EmbeddingGemma 2 (local, opcional)\n8. Versoes e atualizacoes dos agentes\n9. Diagnostico do ambiente\n0. Sair\n\n'
            if ! read -r -p 'Escolha: ' selection; then
                exit 0
            fi
            case "$selection" in
                1) tool_name=copilot ;;
                2) tool_name=claude ;;
                3) tool_name=codex ;;
                4) tool_name=terminal ;;
                5) tool_name=agy ;;
                6) tool_name=opencode ;;
                7) tool_name=embeddinggemma ;;
                8) run_maintenance update_agents || true; continue ;;
                9) run_maintenance show_diagnostics || true; continue ;;
                0) exit 0 ;;
                *) printf '%s\n' 'Opcao invalida.' >&2; exit 2 ;;
            esac
            break
        done
    elif [[ "$1" == --help || "$1" == -h ]]; then
        show_help
        exit 0
    elif [[ "$1" == versoes ]]; then
        shift
        status=0
        run_maintenance show_versions "$@" || status=$?
        exit "$status"
    elif [[ "$1" == atualizar ]]; then
        shift
        status=0
        run_maintenance update_agents "$@" || status=$?
        exit "$status"
    elif [[ "$1" == diagnostico ]]; then
        shift
        status=0
        run_maintenance show_diagnostics "$@" || status=$?
        exit "$status"
    elif [[ "$1" == web ]]; then
        shift
        status=0
        manage_web "$@" || status=$?
        exit "$status"
    elif { [[ "$1" == embeddinggemma || "$1" == embedding ]] && [[ ${2:-} == install ]]; }; then
        shift 2
        status=0
        install_embeddinggemma "$@" || status=$?
        exit "$status"
    else
        tool_name="$1"
        shift
    fi
else
    tool_name="$launcher_name"
fi

case "$tool_name" in
    codex|copilot|claude|opencode) ;;
    antigravity|agy) tool_name=agy ;;
    embeddinggemma|embedding) tool_name=embeddinggemma ;;
    terminal|linux|ubuntu)
        tool_name=/bin/bash
        set -- -l "$@"
        ;;
    *) show_help >&2; exit 2 ;;
esac

if [[ ${TERMUX_AI_GUEST:-} == 1 ]]; then
    if [[ $tool_name == embeddinggemma ]]; then
        printf '%s\n' 'EmbeddingGemma 2 nao esta instalado no Linux. Ele e opcional: veja a secao EmbeddingGemma 2 do README.' >&2
    else
        printf '%s\n' 'O agente nao foi encontrado dentro do Linux. Execute novamente o instalador pelo Termux.' >&2
    fi
    exit 1
fi

require_proot_distro
load_linux_config

if [[ $tool_name == codex ]]; then
    classify_codex_args "$@"
    case "$codex_mode" in
        ask)
            printf '%s\n' \
                'Codex: o sandbox nao funciona no Android/PRoot.' \
                'Modo Pedir aprovacao: confirme cada comando ou edicao. Detalhes: ia diagnostico' >&2
            set -- "${@:1:codex_insert_index}" -s workspace-write -a on-request "${@:codex_insert_index+1}"
            ;;
        warn)
            printf '%s\n' \
                'Codex: sem sandbox no Android/PRoot, os comandos do agente falham em exec e review.' \
                'Prefira ia codex, que abre no modo Pedir aprovacao. Detalhes: ia diagnostico' >&2
            ;;
    esac
fi

exec proot-distro "${login_args[@]}" --work-dir "$PWD" -- \
    /bin/bash -lc 'export TERMUX_AI_GUEST=1; export PATH="$HOME/.local/bin:$PATH"; exec "$@"' \
    termux-ai "$tool_name" "$@"